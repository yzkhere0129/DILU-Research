FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      matrixDumperDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// DENSE: 384 dump points, every 3 ns from step 50 to step 1199.
// Covers cold start (50-150ns) + melting (150-450ns) + early evap (450-700ns)
// + full evap/keyhole (700-1200ns).
// Used by experiments/solver_production_comparison amortized replay test.

enabled         true;
binaryMM        false;          // ASCII MTX (transferable, parseable)
outputDir       "postProcessing/matrices";

dumpTimeSteps   (
    50 53 56 59 62 65 68 71 74 77
    80 83 86 89 92 95 98 101 104 107
    110 113 116 119 122 125 128 131 134 137
    140 143 146 149 152 155 158 161 164 167
    170 173 176 179 182 185 188 191 194 197
    200 203 206 209 212 215 218 221 224 227
    230 233 236 239 242 245 248 251 254 257
    260 263 266 269 272 275 278 281 284 287
    290 293 296 299 302 305 308 311 314 317
    320 323 326 329 332 335 338 341 344 347
    350 353 356 359 362 365 368 371 374 377
    380 383 386 389 392 395 398 401 404 407
    410 413 416 419 422 425 428 431 434 437
    440 443 446 449 452 455 458 461 464 467
    470 473 476 479 482 485 488 491 494 497
    500 503 506 509 512 515 518 521 524 527
    530 533 536 539 542 545 548 551 554 557
    560 563 566 569 572 575 578 581 584 587
    590 593 596 599 602 605 608 611 614 617
    620 623 626 629 632 635 638 641 644 647
    650 653 656 659 662 665 668 671 674 677
    680 683 686 689 692 695 698 701 704 707
    710 713 716 719 722 725 728 731 734 737
    740 743 746 749 752 755 758 761 764 767
    770 773 776 779 782 785 788 791 794 797
    800 803 806 809 812 815 818 821 824 827
    830 833 836 839 842 845 848 851 854 857
    860 863 866 869 872 875 878 881 884 887
    890 893 896 899 902 905 908 911 914 917
    920 923 926 929 932 935 938 941 944 947
    950 953 956 959 962 965 968 971 974 977
    980 983 986 989 992 995 998 1001 1004 1007
    1010 1013 1016 1019 1022 1025 1028 1031 1034 1037
    1040 1043 1046 1049 1052 1055 1058 1061 1064 1067
    1070 1073 1076 1079 1082 1085 1088 1091 1094 1097
    1100 1103 1106 1109 1112 1115 1118 1121 1124 1127
    1130 1133 1136 1139 1142 1145 1148 1151 1154 1157
    1160 1163 1166 1169 1172 1175 1178 1181 1184 1187
    1190 1193 1196 1199
);

// Only pd (corr0 only) — saves IO + storage; pd is the interesting matrix
equations       (pd);

maxCorrectorsPerEq
{
    pd  1;
}

